#version 450
#extension GL_GOOGLE_include_directive : require
#if DENORM == 1
#extension GL_EXT_spirv_intrinsics : require
// DenormFlushToZero for 32-bit floats: execution mode 4460, capability 4465
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4465], 4460, 32);
#elif DENORM == 2
#extension GL_EXT_spirv_intrinsics : require
// DenormPreserve for 32-bit floats: execution mode 4459, capability 4464
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 32);
#endif
#include "shadow_build.glsl"

// A triangle's facing, as R_CalcInteractionFacing finds it from the CPU's
// own face plane - its dot with the light origin, each operation the
// CPU's, in its order, none fused (precise) - then the frustum cull the
// same way.  Then the caps of a triangle facing away.

layout(local_size_x = 64) in;

float parm(uint i) { return uintBitsToFloat(parms[pc.parmBase + i]); }

uint fetchIndex(uint i)
{
    uint at = pc.indexBase + i;
    if (pc.shortIndexes == 0u)
        return ix[at];
    return (ix[at >> 1] >> ((at & 1u) * 16u)) & 0xffffu;
}

// ((x + y) + z) + d, or ((x + d) + y) + z
float dot4(float x, float y, float z, float d)
{
    precise float t;
    if (parms[pc.parmBase + 38u] == 0u)
    {
        t = x + y;
        t = t + z;
        t = t + d;
    }
    else
    {
        t = x + d;
        t = t + y;
        t = t + z;
    }
    return t;
}

// the planes of a group behind which a vertex lies, as Dot( plane, drawVert ) < LIGHT_CLIP_EPSILON
uint behind(vec3 p, uint group)
{
    uint bits = 0u;
    uint k;
    for (k = 0u; k < 4u; k++)
    {
        uint b = 4u + group * 16u;
        precise float x = p.x * parm(b + k);
        precise float y = p.y * parm(b + 4u + k);
        precise float z = p.z * parm(b + 8u + k);
        if (dot4(x, y, z, parm(b + 12u + k)) < 0.1)
            bits |= 1u << k;
    }
    return bits;
}

void main()
{
    uint tri = gl_GlobalInvocationID.x;
    uint i0, i1, i2, face, cull, slot, at;
    vec3 a, b, c;
    vec4 pl;
    precise float x, y, z;

    if (tri >= pc.numFaces)
        return;
    i0 = fetchIndex(tri * 3u + 0u);
    i1 = fetchIndex(tri * 3u + 1u);
    i2 = fetchIndex(tri * 3u + 2u);

    pl = facePlane[pc.planeBase + tri];
    x = pl.x * parm(0u);
    y = pl.y * parm(1u);
    z = pl.z * parm(2u);
    face = dot4(x, y, z, pl.w) >= 0.0 ? 1u : 0u;

    a = sc[pc.vertexBase + 2u * i0].xyz;
    b = sc[pc.vertexBase + 2u * i1].xyz;
    c = sc[pc.vertexBase + 2u * i2].xyz;
    if (face == 0u)
    {
        cull = behind(a, 0u) & behind(b, 0u) & behind(c, 0u) & parms[pc.parmBase + 36u];
        cull |= behind(a, 1u) & behind(b, 1u) & behind(c, 1u) & parms[pc.parmBase + 37u];
        if (cull != 0u)
            face = 1u;
    }
    facing[pc.facingBase + tri] = face;
    if (face != 0u)
        return;

    slot = atomicAdd(parms[PARM_CAP_DRAW], 6u);
    at = parms[PARM_CAP_DRAW + 2u] + slot;
    outIndex[at + 0u] = i2 << 1;
    outIndex[at + 1u] = i1 << 1;
    outIndex[at + 2u] = i0 << 1;
    outIndex[at + 3u] = (i0 << 1) | 1u;
    outIndex[at + 4u] = (i1 << 1) | 1u;
    outIndex[at + 5u] = (i2 << 1) | 1u;
}
